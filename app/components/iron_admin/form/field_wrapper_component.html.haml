%div{ class: wrapper_classes }
  %label{ for: name, class: label_classes }
    = label
    - if required
      %span{ class: theme.error_text } *

  = content

  - if hint && !has_errors?
    %p.mt-1.text-sm{ class: theme.muted_text }
      = hint

  - if has_errors?
    %div{ class: error_classes }
      = heroicon "exclamation-circle", variant: :mini, options: { class: "h-4 w-4 shrink-0 #{theme.error_text}" }
      %p.text-sm{ class: theme.error_text }
        = errors.join(", ")
