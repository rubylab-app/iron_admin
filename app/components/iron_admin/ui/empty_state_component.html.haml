.text-center.py-12
  .mx-auto.flex.h-10.w-10.items-center.justify-center{ class: "#{theme.surface_muted} #{theme.border_width} #{theme.card_border} #{theme.border_radius}" }
    = heroicon icon, variant: :outline, options: { class: "h-5 w-5 #{theme.icon_muted}" }
  %h3.mt-4{ class: "#{theme.card_title} #{theme.heading_font}" }
    = title
  - if description
    %p.mt-1.text-sm{ class: theme.muted_text }
      = description
  - if has_action?
    .mt-6
      = render IronAdmin::Ui::ButtonComponent.new(text: action_text, href: action_href)
