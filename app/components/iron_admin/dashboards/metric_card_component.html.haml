-# Label on top, figure below on its own full-width row. The figure has no break-words, so a narrow
-# xl card never splits a number, and its size comes from the theme's metric_value alone.
%div{ class: "#{card_classes} p-5", **(live? ? { id: live_target_id } : {}) }
  .flex.items-center.justify-between.gap-3
    %p.min-w-0.break-words{ class: label_classes }= label
    - if icon
      .flex.h-8.w-8.shrink-0.items-center.justify-center{ class: icon_tile_classes }
        = heroicon icon, variant: :outline, options: { class: "h-4 w-4", "stroke-width": IronAdmin::ApplicationHelper::SMALL_ICON_STROKE }
  %p.mt-2{ class: theme.metric_value }= formatted_value
