-# Laid out like MetricCardComponent: the label wraps beside the icon instead of reaching it, and the
-# value sits on its own full-width row, so a long value never pushes the icon out of a narrow card.
%div{ class: "#{card_classes} p-5" }
  .flex.items-center.justify-between.gap-3
    %p.min-w-0.break-words{ class: label_classes }= label
    - if icon
      .flex.h-8.w-8.shrink-0.items-center.justify-center{ class: icon_tile_classes }
        = heroicon icon, variant: :outline, options: { class: "h-4 w-4" }
  %p.mt-2{ class: theme.metric_value }= value
  - if change
    .mt-1.flex.items-center.gap-1.text-sm.font-medium{ class: change_classes }
      - if change_icon
        = heroicon change_icon, variant: :mini, options: { class: "h-4 w-4" }
      %span.tabular-nums= change
