-# Laid out like MetricCardComponent: the label wraps beside the icon instead of reaching it, and the
-# value sits on its own full-width row, so a long value never pushes the icon out of a narrow card.
%div{ class: "#{theme.card_bg} border #{theme.card_border} #{theme.border_radius} #{theme.card_shadow} p-6" }
  .flex.items-start.justify-between.gap-4
    %p.min-w-0.break-words.text-sm.font-medium{ class: theme.muted_text }= label
    - if icon
      .shrink-0.p-3.rounded-full.bg-indigo-50
        = heroicon icon, variant: :outline, options: { class: "h-6 w-6 text-indigo-600" }
  %p.mt-2.text-3xl.font-semibold{ class: "#{theme.body_text} xl:text-2xl 2xl:text-3xl" }= value
  - if change
    .flex.items-center.gap-1.mt-2{ class: change_classes }
      - if change_icon
        = heroicon change_icon, variant: :mini, options: { class: "h-4 w-4" }
      %span.text-sm= change
