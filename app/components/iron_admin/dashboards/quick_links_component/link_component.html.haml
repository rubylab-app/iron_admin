= link_to href, class: "flex items-center gap-3 px-5 py-3 transition-colors #{theme.item_hover} #{theme.focus_ring}" do
  - if icon
    .flex.h-8.w-8.shrink-0.items-center.justify-center{ class: icon_tile_classes }
      = heroicon icon, variant: :outline, options: { class: "h-4 w-4" }
  .min-w-0.flex-1
    %p.text-sm.font-medium{ class: theme.body_text }= label
    - if description
      %p.text-sm{ class: theme.muted_text }= description
  = heroicon "chevron-right", variant: :mini, options: { class: "h-4 w-4 shrink-0 #{theme.icon_muted}" }
