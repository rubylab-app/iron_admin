-# overflow-hidden keeps the row hover inside the card's rounded corners. The card is a size
-# container: its cells fit its own width, wherever a dashboard layout puts it.
%div{ class: "#{card_classes} overflow-hidden @container" }
  -# Padded like the cells, so the title starts where the first column does.
  .border-b{ class: "#{theme.card_border} #{theme.table_cell_padding}" }
    %h2{ class: title_classes }= "Recent #{label}"
  -# A table wider than the card scrolls sideways; cp-scroll-fade fades the edge it can scroll toward.
  .overflow-x-auto.cp-scroll-fade{ class: theme.table_frame }
    -# divide-y takes its color from table_head_border (else table_border): a border color on the table would leave the dividers in currentColor.
    %table.min-w-full.divide-y{ class: theme.table_head_divider }
      %thead{ class: theme.table_header_bg }
        %tr
          - fields.each do |field|
            %th.text-left.whitespace-nowrap{ scope: "col", class: header_cell_classes }= field.name.to_s.humanize
      %tbody.divide-y{ class: theme.table_border }
        - ordered_records.each do |record|
          %tr{ class: theme.table_row_hover }
            - fields.each do |field|
              %td.text-sm{ class: cell_classes(field) }= display_value(record, field)
