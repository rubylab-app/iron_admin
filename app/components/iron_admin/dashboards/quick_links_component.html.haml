%div{ class: card_classes }
  -# py-3.5 goes in the class string: in HAML's dot syntax ".py-3.5" is the classes "py-3" and "5".
  %div{ class: "border-b px-5 py-3.5 #{theme.card_border}" }
    %h2{ class: title_classes }= title

  -# divide-y takes its color from table_border: a border color on the list would leave the dividers in currentColor.
  .divide-y{ class: theme.table_border }
    - links.each do |link|
      = link
