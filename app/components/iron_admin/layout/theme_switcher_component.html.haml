%details.relative{ data: { controller: "cp-disclosure", action: "keydown->cp-disclosure#closeOnEscape click@document->cp-disclosure#closeOnOutsideClick" } }
  %summary.flex.h-9.w-9.cursor-pointer.list-none.items-center.justify-center{ class: "#{theme.control_radius} #{theme.btn_ghost} #{theme.focus_ring} [&::-webkit-details-marker]:hidden", data: { cp_disclosure_target: "summary" } }
    = heroicon "swatch", variant: :outline, options: { class: "h-5 w-5" }
    %span.sr-only= summary_label
  .absolute.right-0.z-40.mt-2.w-56.p-1{ class: "#{theme.card_bg} #{theme.border_width} #{theme.card_border} #{theme.border_radius} #{theme.card_shadow}" }
    = form_with url: helpers.iron_admin.theme_path, method: :post, data: { turbo: false }, html: { role: "group", "aria-label": menu_label } do
      = hidden_field_tag :return_to, helpers.request.fullpath, id: nil
      - themes.each do |option|
        %button.flex.w-full.cursor-pointer.items-center.gap-2.px-2.py-1.5.text-left.text-sm{ type: "submit", name: "theme", value: option.name, "aria-pressed": current?(option).to_s, class: "#{theme.control_radius} #{theme.body_text} #{theme.item_hover} #{theme.focus_ring}" }
          %span.h-4.w-4.shrink-0.rounded-full{ "aria-hidden": "true", class: option.swatch }
          %span.flex-1.truncate= option.label
          - if current?(option)
            = heroicon "check", variant: :mini, options: { class: "h-4 w-4 shrink-0 #{theme.icon_muted}" }
