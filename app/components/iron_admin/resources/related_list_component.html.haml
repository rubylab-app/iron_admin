%div{ class: panel_classes }
  %div{ class: header_classes }
    %h2{ class: title_classes }
      = title
    = link_to I18n.t("iron_admin.resources.show.view_all"), view_all_url, class: "text-sm #{theme.link}"

  .overflow-x-auto.cp-scroll-fade
    %table.min-w-full
      %tbody{ class: body_classes }
        - records.each do |record|
          %tr{ class: theme.table_row_hover }
            %td{ class: "text-sm #{theme.table_cell_padding}" }
              = link_to helpers.display_record_label(record, display_method), record_url(record), class: theme.link
