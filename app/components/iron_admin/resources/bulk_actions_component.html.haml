%div{ class: toolbar_classes, data: { controller: "bulk-actions", bulk_actions_target: "toolbar" } }
  %span.text-sm{ class: theme.muted_text }
    %span.tabular-nums{ data: { bulk_actions_target: "count" } } 0
    selected

  .flex.flex-wrap.gap-2
    - actions.each do |action|
      = button_to action_url(action), method: :post, form: { data: { bulk_actions_target: "form" } },
        class: button_classes do
        - if action[:icon]
          = heroicon action[:icon], variant: :mini, options: { class: "h-4 w-4" }
        = action[:name].to_s.humanize

  %button.ml-auto.text-sm{ type: "button", class: "#{theme.link_muted} #{theme.focus_ring}", data: { action: "bulk-actions#clearAll" } }
    Clear selection
