%nav.flex{ aria: { label: "Breadcrumb" } }
  %ol.flex.flex-wrap.items-center{ class: "gap-1.5", role: "list" }
    - items.each_with_index do |item, index|
      %li.flex.items-center{ class: "gap-1.5" }
        - unless index.zero?
          = heroicon "chevron-right", variant: :mini, options: { class: "h-4 w-4 shrink-0 #{theme.icon_muted}", "aria-hidden": "true" }
        = item
