%div{ class: frame_classes }
  %table{ class: table_classes }
    %thead{ class: header_classes }
      %tr
        - visible_fields.each do |field|
          %th{ scope: "col", class: header_cell_classes }
            -# A whole-page visit, so forms outside the records frame get the new sort.
            = link_to sort_url(field.name), class: sort_link_classes, data: { turbo_frame: "_top" } do
              = field.name.to_s.humanize
              - if !sorted?(field.name)
                = heroicon "chevron-up-down", variant: :mini, options: { class: "h-3.5 w-3.5 opacity-0 group-hover:opacity-50 transition-opacity" }
              - elsif sort_direction == "asc"
                = heroicon "chevron-up", variant: :mini, options: { class: "h-3.5 w-3.5" }
              - else
                = heroicon "chevron-down", variant: :mini, options: { class: "h-3.5 w-3.5" }
        -# relative keeps the absolutely positioned sr-only text inside the scrolling table.
        %th{ scope: "col", class: "relative #{theme.table_cell_padding}" }
          %span.sr-only Actions

    %tbody{ class: body_classes }
      - if empty?
        %tr
          %td.px-4.py-12.text-center.text-sm{ colspan: visible_fields.size + 1, class: theme.muted_text }
            - if empty_state?
              = empty_state
            - else
              No records found.
      - else
        - records.each do |record|
          %tr{ id: row_dom_id(record), class: theme.table_row_hover }
            - visible_fields.each do |field|
              %td{ class: cell_classes(field) }
                = helpers.display_index_field_value(record, field)
            %td{ class: "whitespace-nowrap text-right text-sm #{theme.table_cell_padding}" }
              = link_to "View", helpers.iron_admin.resource_path(resource_class.resource_name, record),
                class: theme.link, data: { turbo_frame: "_top" }
