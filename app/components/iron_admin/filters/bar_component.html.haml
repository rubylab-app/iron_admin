.flex.justify-end.mb-4
  %details.relative.group{ open: has_active_filters? || nil }
    %summary{ class: trigger_classes, style: "list-style: none; -webkit-appearance: none;" }
      = heroicon "funnel", variant: :mini, options: { class: "h-4 w-4 #{theme.icon_muted}" }
      %span Filters
      - if has_active_filters?
        %span{ class: count_classes }
          = active_count
      = heroicon "chevron-down", variant: :mini, options: { class: "h-4 w-4 #{theme.icon_muted} transition-transform group-open:rotate-180" }

    %div{ class: dropdown_classes }
      = form_tag form_url, method: :get, class: "p-4" do
        = hidden_field_tag :scope, scope, id: nil
        = hidden_field_tag :q, query, id: nil
        - sort_params.each do |name, value|
          = hidden_field_tag name, value, id: nil

        .space-y-3
          - filters.each do |filter|
            = filter

        %div{ class: footer_classes }
          %button{ type: "submit", class: apply_classes }
            Apply
          = link_to "Clear", clear_url, class: clear_classes
