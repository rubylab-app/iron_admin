.space-y-1
  %label{ for: field_id, class: label_classes }
    = label
  %select{ name: field_name, id: field_id, class: select_classes }
    %option{ value: "" } All
    - options.each do |option|
      - opt_label, opt_value = option.is_a?(Array) ? option : [option.to_s.humanize, option]
      %option{ value: opt_value, selected: selected.to_s == opt_value.to_s }= opt_label
