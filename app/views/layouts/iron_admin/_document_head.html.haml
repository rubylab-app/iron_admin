%meta{ charset: "utf-8" }
%meta{ name: "viewport", content: "width=device-width, initial-scale=1" }
%meta{ name: "color-scheme", content: theme.dark? ? "dark" : "light" }
%title= IronAdmin.configuration.title
- if IronAdmin.configuration.favicon.present?
  -# type: nil, because favicon_link_tag would claim image/x-icon for any file.
  = favicon_link_tag IronAdmin.configuration.favicon, type: nil
= csrf_meta_tags
= csp_meta_tag
- if theme.font_stylesheet_url.present?
  - if cp_google_fonts?
    %link{ rel: "preconnect", href: "https://fonts.googleapis.com" }
    %link{ rel: "preconnect", href: "https://fonts.gstatic.com", crossorigin: "anonymous" }
  %link{ rel: "stylesheet", href: theme.font_stylesheet_url }
= stylesheet_link_tag "tailwind", "data-turbo-track": "reload"
- if defined?(ActionText)
  = stylesheet_link_tag "trix", "data-turbo-track": "reload"
= javascript_importmap_tags
%script{ type: "module" }
  import "iron_admin"
- if defined?(ActionText)
  %script{ type: "module" }
    import "trix"
    import "@rails/actiontext"
