!!!
%html{ lang: I18n.locale }
  %head
    %meta{ charset: "utf-8" }
    %meta{ name: "viewport", content: "width=device-width, initial-scale=1" }
    %title= IronAdmin.configuration.title
    - if IronAdmin.configuration.favicon.present?
      -# type: nil, because favicon_link_tag would claim image/x-icon for any file.
      = favicon_link_tag IronAdmin.configuration.favicon, type: nil
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag "tailwind", "data-turbo-track": "reload"
    - if defined?(ActionText)
      = stylesheet_link_tag "trix", "data-turbo-track": "reload"
    = javascript_importmap_tags
    %script{ type: "module" }
      import "iron_admin"
    - if defined?(ActionText)
      %script{ type: "module" }
        import "trix"
        import "@rails/actiontext"
  %body.text-gray-900.antialiased{ class: IronAdmin.configuration.theme.main_bg }
    = render iron_admin_component(:shell, current_user: iron_admin_current_user) do
      = yield
