.px-4.sm:px-6.lg:px-8.py-6.max-w-3xl.mx-auto
  .mb-6
    %h1{ class: "#{t.page_title} #{t.heading_font}" }= I18n.t("iron_admin.imports.new.title", model: @resource_class.label)
    %p.mt-1.text-sm{ class: cp_muted_text }= I18n.t("iron_admin.imports.new.subtitle")

  .p-6{ class: cp_card }
    -# The preview is rendered in reply to this POST. Turbo Drive only accepts a
    -# redirect after a form submission, so the upload is a full page request.
    = form_tag resource_import_preview_path(@resource_class.resource_name),
      multipart: true, class: "space-y-5", data: { turbo: false } do
      .space-y-1.5
        = label_tag :file, I18n.t("iron_admin.imports.new.file_label"), class: "block text-sm font-medium #{cp_label_text}"
        = file_field_tag :file, required: true, class: cp_file_input_class
      .space-y-1.5
        = label_tag :import_format, I18n.t("iron_admin.imports.new.format_label"), class: "block text-sm font-medium #{cp_label_text}"
        = select_tag :import_format,
          options_for_select(@formats.map { |format| [format.to_s.upcase, format] }),
          class: cp_select_class
      - if @fields.any?
        .space-y-2
          %p.text-sm.font-medium{ class: cp_label_text }= I18n.t("iron_admin.imports.new.fields_label")
          .flex.flex-wrap.gap-2
            - @fields.each do |field|
              %span.inline-flex.items-center.px-2.text-xs{ class: "py-0.5 #{t.badge_shape} #{t.chip}" }
                = field.name.to_s.humanize
      .flex.items-center.gap-3.pt-5.border-t{ class: t.card_border }
        %button{ type: "submit", class: cp_btn_primary_lg }
          = heroicon "eye", variant: :mini, options: { class: "h-4 w-4" }
          %span= I18n.t("iron_admin.imports.new.preview_button")
        = link_to I18n.t("iron_admin.form.cancel_button"), resources_path(@resource_class.resource_name), class: cp_btn_secondary
