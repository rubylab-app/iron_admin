.px-4.sm:px-6.lg:px-8.py-6.max-w-5xl.mx-auto
  .flex.items-center.justify-between.gap-3.flex-wrap.mb-6
    %div
      %h1{ class: "#{t.page_title} #{t.heading_font}" }= I18n.t("iron_admin.imports.preview.title", model: @resource_class.label)
      %p.mt-1.text-sm{ class: cp_muted_text }= I18n.t("iron_admin.imports.preview.summary", count: @preview.total_rows)
    .flex.items-center.gap-3.flex-wrap
      = link_to I18n.t("iron_admin.imports.preview.back_button"), resource_import_path(@resource_class.resource_name), class: cp_btn_secondary
      - if @preview.total_rows.positive?
        -# Posts the previewed upload back to #create, so nothing is uploaded twice.
        = form_tag resource_import_path(@resource_class.resource_name), multipart: true do
          = hidden_field_tag :import_format, @import_format, id: nil
          = hidden_field_tag :import_data, @import_data, id: nil
          %button{ type: "submit", class: cp_btn_primary_lg }
            = heroicon "arrow-up-tray", variant: :mini, options: { class: "h-4 w-4" }
            %span= I18n.t("iron_admin.imports.preview.import_button", count: @preview.total_rows)

  .mb-6.p-4{ class: cp_card }
    %h2.mb-3{ class: "#{t.card_title} #{t.heading_font}" }= I18n.t("iron_admin.imports.preview.mapping_title")
    .flex.flex-wrap.gap-2
      - @preview.mapping.each do |header, field_name|
        %span.inline-flex.items-center.px-2.text-xs{ class: "py-0.5 #{t.badge_shape} #{t.chip}" }
          = "#{header} -> #{field_name.to_s.humanize}"

  -# The table scrolls sideways on a narrow screen and its rows hold nothing focusable, so the
  -# frame takes the focus itself: a keyboard can then scroll it with the arrow keys.
  .overflow-x-auto{ tabindex: 0, role: "region", "aria-label": I18n.t("iron_admin.imports.preview.table_label"), class: "#{cp_card} #{t.table_frame} #{t.focus_ring}" }
    %table.min-w-full.divide-y{ class: t.table_head_divider }
      %thead{ class: cp_table_header_bg }
        %tr
          - @preview.mapping.values.each do |field_name|
            %th.text-left{ scope: "col", class: "#{t.table_cell_padding} #{t.table_header_text} #{t.label_transform}" }= field_name.to_s.humanize
          %th.text-left{ scope: "col", class: "#{t.table_cell_padding} #{t.table_header_text} #{t.label_transform}" }= I18n.t("iron_admin.imports.preview.status_column")
      %tbody.divide-y{ class: cp_table_border }
        - @preview.rows.each do |row|
          %tr
            - @preview.mapping.values.each do |field_name|
              %td.whitespace-nowrap.text-sm{ class: "#{t.table_cell_padding} #{cp_body_text}" }= @preview.cell_text(row, field_name)
            %td.text-sm{ class: "#{t.table_cell_padding} #{row.errors.any? ? t.error_text : cp_muted_text}" }
              - if row.errors.any?
                = row.errors.map(&:message).join(", ")
              - else
                = I18n.t("iron_admin.imports.preview.valid_status")
