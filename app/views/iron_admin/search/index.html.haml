- styles = IronAdmin::Resources::Styles

.px-4.sm:px-6.lg:px-8.py-6.max-w-7xl.mx-auto
  %h1.mb-6{ class: styles.page_title(t) }= @query.present? ? "Search results for \"#{@query}\"" : "Search results"
  - if @results&.any?
    - @results.each do |group|
      %section.mb-6
        %h2.mb-2{ class: styles.panel_title(t) }= group[:resource].label
        %div{ class: "#{styles.panel(t)} #{styles.divided(t)}" }
          - group[:records].each do |record|
            = link_to resource_path(group[:resource].resource_name, record), class: styles.list_row(t) do
              = display_record_label(record)
  - elsif @query.present?
    .text-center.py-12.text-sm{ class: t.muted_text } No results found.
