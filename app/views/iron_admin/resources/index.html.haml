- filters = iron_admin_visible_filters
- styles = IronAdmin::Resources::Styles
- controls = IronAdmin::Filters::ControlStyles

.px-4.sm:px-6.lg:px-8.py-6.max-w-7xl.mx-auto
  .flex.items-center.justify-between.gap-3.flex-wrap.mb-6
    %h1{ class: styles.page_title(t) }= @resource_class.label
    .flex.items-center.gap-2
      - if @resource_class.import_enabled? && @resource_class.crud_allowed?(:create, iron_admin_current_user)
        = link_to resource_import_path(@resource_class.resource_name),
          class: cp_btn_secondary do
          = heroicon "arrow-up-tray", variant: :mini, options: { class: "h-4 w-4" }
          %span= I18n.t("iron_admin.resources.index.import_button")
      - if @resource_class.crud_allowed?(:create, iron_admin_current_user)
        = link_to I18n.t("iron_admin.resources.index.new_button", model: @resource_class.model.model_name.human),
          new_resource_path(@resource_class.resource_name),
          class: cp_btn_primary

  - if @resource_class.all_scopes.any? || @resource_class.searchable_columns.any?
    .flex.items-center.justify-between.gap-3.flex-wrap.mb-4
      - if @resource_class.all_scopes.any?
        -# A tab keeps the search, filters and sort, and starts back at the first page.
        - scope_tab_state = iron_admin_index_state.except("scope", "page").symbolize_keys
        .flex.gap-1.border-b.overflow-x-auto{ class: t.card_border }
          - @resource_class.all_scopes.each do |scope|
            - active = @current_scope == scope[:name].to_s
            = link_to scope[:name].to_s.humanize,
              resources_path(@resource_class.resource_name, **scope_tab_state, scope: scope[:name]),
              class: "px-3 py-2 text-sm font-medium border-b-2 -mb-px whitespace-nowrap #{active ? cp_scope_active : cp_scope_inactive}"

      - if @resource_class.searchable_columns.any? && (search_component = iron_admin_search_component(@resource_class, scope: @current_scope))
        = render search_component
      - elsif @resource_class.searchable_columns.any?
        = form_tag resources_path(@resource_class.resource_name), method: :get, class: "flex w-full sm:w-auto sm:ml-auto" do
          - iron_admin_search_hidden_params(@current_scope).each do |name, value|
            = hidden_field_tag name, value, id: nil
          .relative.w-full.sm:w-64
            .pointer-events-none.absolute.inset-y-0.left-0.flex.items-center.pl-3
              = heroicon "magnifying-glass", variant: :mini, options: { class: "h-4 w-4 #{t.icon_muted}" }
            = text_field_tag :q, params[:q],
              placeholder: I18n.t("iron_admin.resources.index.search_placeholder"),
              "aria-label": I18n.t("iron_admin.resources.index.search_label", resource: @resource_class.label),
              class: controls.search_input(t)

  - if filters.any? && (filter_bar_component = iron_admin_filter_bar_component(@resource_class, filters: filters, scope: @current_scope))
    = render filter_bar_component
  - elsif filters.any?
    - has_active_filters = filters.any? { |f| iron_admin_active_filter?(f) }
    .flex.justify-end.mb-4
      %details.relative.group{ open: has_active_filters || nil }
        %summary{ class: controls.trigger(t), style: "list-style: none;" }
          = heroicon "funnel", variant: :mini, options: { class: "h-4 w-4 #{t.icon_muted}" }
          %span= I18n.t("iron_admin.resources.index.filters_label")
          - if has_active_filters
            - active_count = filters.count { |f| iron_admin_active_filter?(f) }
            %span{ class: controls.count(t) }
              = active_count
          = heroicon "chevron-down", variant: :mini, options: { class: "h-4 w-4 #{t.icon_muted} transition-transform group-open:rotate-180" }
        %div{ class: controls.panel(t) }
          = form_tag resources_path(@resource_class.resource_name), method: :get, class: "p-4" do
            = hidden_field_tag :scope, @current_scope, id: nil
            = hidden_field_tag :q, params[:q], id: nil
            - iron_admin_index_state.slice("sort", "direction").each do |name, value|
              = hidden_field_tag name, value, id: nil
            .space-y-3
              - filters.each do |filter|
                - filter_label = filter[:name].to_s.humanize
                - filter_id = "filters_#{filter[:name]}"
                -# The label names the select, or the value input of an operator filter.
                - label_for = { date_range: "#{filter_id}_from", string: "#{filter_id}_value", number: "#{filter_id}_value" }.fetch(filter[:type], filter_id)
                .space-y-1
                  %label{ for: label_for, class: controls.label(t) }
                    = filter_label
                  - case filter[:type]
                  - when :select, :boolean
                    %select{ name: "filters[#{filter[:name]}]", id: filter_id, class: controls.select(t) }
                      %option{ value: "" }= I18n.t("iron_admin.resources.index.all_option")
                      - filter_options_for(@resource_class, filter).each do |label, value|
                        %option{ value: value, selected: iron_admin_filter_param(filter[:name]) == value.to_s }= label
                  - when :date_range
                    .space-y-2
                      = date_field_tag "filters[#{filter[:name]}_from]", iron_admin_filter_param("#{filter[:name]}_from"),
                        class: controls.input(t),
                        "aria-label": I18n.t("iron_admin.filters.from_label", filter: filter_label),
                        placeholder: I18n.t("iron_admin.filters.from")
                      = date_field_tag "filters[#{filter[:name]}_to]", iron_admin_filter_param("#{filter[:name]}_to"),
                        class: controls.input(t),
                        "aria-label": I18n.t("iron_admin.filters.to_label", filter: filter_label),
                        placeholder: I18n.t("iron_admin.filters.to")
                  - when :string
                    - string_ops = %w[contains equals starts_with ends_with]
                    - current_op = iron_admin_filter_param(filter[:name].to_s, "op") || "contains"
                    - current_val = iron_admin_filter_param(filter[:name].to_s, "value") || ""
                    .space-y-2
                      %select{ name: "filters[#{filter[:name]}][op]", id: "#{filter_id}_op", "aria-label": I18n.t("iron_admin.filters.operator_label", filter: filter_label), class: controls.select(t) }
                        - string_ops.each do |op|
                          %option{ value: op, selected: current_op == op }= I18n.t("iron_admin.filters.operators.#{op}")
                      = text_field_tag "filters[#{filter[:name]}][value]", current_val,
                        class: controls.input(t),
                        placeholder: filter[:label] || filter[:name].to_s.humanize
                  - when :number
                    - number_ops = %w[equals greater_than less_than between]
                    - current_op = iron_admin_filter_param(filter[:name].to_s, "op") || "equals"
                    - current_val = iron_admin_filter_param(filter[:name].to_s, "value") || ""
                    - current_val_upper = iron_admin_filter_param(filter[:name].to_s, "value_2") || ""
                    .space-y-2{ data: { controller: "filter-operator" } }
                      %select{ name: "filters[#{filter[:name]}][op]", id: "#{filter_id}_op", "aria-label": I18n.t("iron_admin.filters.operator_label", filter: filter_label), class: controls.select(t), data: { action: "change->filter-operator#toggle", filter_operator_target: "opSelect" } }
                        - number_ops.each do |op|
                          %option{ value: op, selected: current_op == op }= I18n.t("iron_admin.filters.operators.#{op}")
                      = number_field_tag "filters[#{filter[:name]}][value]", current_val,
                        class: controls.input(t), step: "any",
                        placeholder: filter[:label] || filter[:name].to_s.humanize
                      .flex.items-center.gap-2{ data: { filter_operator_target: "betweenRow" }, class: current_op == "between" ? "" : "hidden" }
                        %span.text-xs{ class: t.muted_text }= I18n.t("iron_admin.filters.between_separator")
                        = number_field_tag "filters[#{filter[:name]}][value_2]", current_val_upper,
                          class: controls.input(t), step: "any",
                          "aria-label": I18n.t("iron_admin.filters.upper_value_label", filter: filter_label)
            %div{ class: controls.footer(t) }
              %button{ type: "submit", class: controls.apply_button(t) }= I18n.t("iron_admin.resources.index.apply_button")
              = link_to I18n.t("iron_admin.resources.index.clear_button"),
                resources_path(@resource_class.resource_name, scope: @current_scope, q: params[:q], **iron_admin_index_state.slice("sort", "direction").symbolize_keys),
                class: "text-sm #{cp_link_muted}"

  - has_bulk_actions = @resource_class.defined_bulk_actions.any?
  = turbo_frame_tag "records", data: { turbo_action: "advance" } do
    -# Submitted to the whole page, so the shell shows the redirect's flash message.
    = form_tag "#", method: :post, id: "bulk-actions-form", data: { turbo_frame: "_top", **(has_bulk_actions ? { controller: "cp-bulk-select" } : {}) } do
      - if has_bulk_actions
        - iron_admin_hidden_params(iron_admin_index_state).each do |name, value|
          = hidden_field_tag name, value, id: nil
        .hidden.flex-wrap.items-center.gap-3.mb-4.px-4.py-2{ data: { cp_bulk_select_target: "bar" }, class: styles.panel(t) }
          %span.text-sm.font-medium{ class: t.muted_text }
            %span.tabular-nums{ data: { cp_bulk_select_target: "count" } } 0
            = I18n.t("iron_admin.resources.index.selected_label", default: "selected")
          .flex.flex-wrap.items-center.gap-2
            - @resource_class.defined_bulk_actions.each do |action|
              %button{ type: "submit", class: styles.secondary_button(t),
                formaction: resource_bulk_action_path(@resource_class.resource_name, action[:name]) }
                - if action[:icon]
                  = heroicon action[:icon], variant: :mini, options: { class: "h-4 w-4" }
                = action[:name].to_s.humanize
      - if (table_component = iron_admin_table_component(@resource_class, records: @records, fields: @fields, scope: @current_scope))
        = render table_component
      - else
        - sticky = IronAdmin.configuration.sticky_actions_column
        - visible_fields = @fields.select { |field| field.visible?(iron_admin_current_user) }
        %div{ class: styles.table_frame(t) }
          %table{ class: styles.table(t) }
            %thead{ class: t.table_header_bg }
              %tr
                - if has_bulk_actions
                  %th.w-4{ scope: "col", class: t.table_cell_padding }
                    %input{ type: "checkbox", class: cp_checkbox_class,
                      "aria-label": I18n.t("iron_admin.resources.index.select_all"),
                      data: { cp_bulk_select_target: "selectAll", action: "change->cp-bulk-select#toggleAll" } }
                - visible_fields.each do |field|
                  - sorted = params[:sort] == field.name.to_s
                  - next_dir = sorted && params[:direction] == "asc" ? "desc" : "asc"
                  %th{ scope: "col", class: styles.header_cell(t) }
                    -# A whole-page visit, so the search and filter forms outside the frame get the new sort.
                    = link_to iron_admin_sort_path(@resource_class, @current_scope, field.name, next_dir),
                      class: "group inline-flex items-center gap-1 #{t.focus_ring}", data: { turbo_frame: "_top" } do
                      = field.name.to_s.humanize
                      - if sorted
                        = heroicon(params[:direction] == "asc" ? "chevron-up" : "chevron-down", variant: :mini, options: { class: "h-3.5 w-3.5" })
                      - else
                        = heroicon "chevron-up-down", variant: :mini, options: { class: "h-3.5 w-3.5 opacity-0 group-hover:opacity-50 transition-opacity" }
                -# sticky or relative keeps the absolutely positioned sr-only text inside the scrolling table.
                %th{ scope: "col", class: "#{t.table_cell_padding} #{sticky ? styles.sticky_header_cell(t) : 'relative'}" }
                  %span.sr-only= I18n.t("iron_admin.resources.show.actions_label")
            %tbody{ class: styles.divided(t) }
              - if @records.empty?
                %tr
                  %td.px-4.py-12.text-center.text-sm{ colspan: visible_fields.size + (has_bulk_actions ? 2 : 1), class: t.muted_text }
                    = I18n.t("iron_admin.resources.index.empty_state")
              - @records.each do |record|
                %tr{ class: t.table_row_hover, **(@resource_class.live_index_enabled? ? { id: "iron_admin_#{@resource_class.resource_name}_row_#{record.id}" } : {}) }
                  - if has_bulk_actions
                    %td.w-4{ class: t.table_cell_padding }
                      %input{ type: "checkbox", name: "ids[]", value: record.id, class: cp_checkbox_class,
                        "aria-label": I18n.t("iron_admin.resources.index.select_record", record: display_record_label(record)),
                        data: { cp_bulk_select_target: "checkbox", action: "change->cp-bulk-select#toggle" } }
                  - visible_fields.each do |field|
                    %td{ class: styles.cell(t, field) }
                      = display_index_field_value(record, field)
                  %td{ class: "whitespace-nowrap text-right text-sm #{t.table_cell_padding} #{sticky ? styles.sticky_cell(t) : ''}" }
                    = link_to I18n.t("iron_admin.resources.index.view_link"), resource_path(@resource_class.resource_name, record),
                      class: cp_link, data: { turbo_frame: "_top" }

    .mt-4
      = render "iron_admin/shared/pagination", pagy: @pagy
