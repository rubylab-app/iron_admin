= turbo_frame_tag "action-form-modal" do
  .px-4.sm:px-6.lg:px-8.py-6.max-w-lg.mx-auto
    %h1.mb-6{ class: "#{t.page_title} #{t.heading_font}" }= @action[:name].to_s.humanize

    .p-6{ class: cp_card }
      = form_tag @form_url, method: :post, class: "space-y-5", data: { turbo_frame: "_top" } do
        %p.text-sm{ class: cp_muted_text }= I18n.t("iron_admin.resources.bulk_action_form.selected", count: @bulk_ids.size)
        -# The selection and the index state it was made on go to the action, which returns to that index.
        - @bulk_ids.each do |id|
          = hidden_field_tag "ids[]", id, id: nil
        - iron_admin_hidden_params(iron_admin_index_state).each do |name, value|
          = hidden_field_tag name, value, id: nil

        - @form_fields.each do |field|
          = render "iron_admin/form/action_field", field: field, scope: "action_form"

        -# The action's confirmation comes here, once the form is filled in.
        - confirm = @action[:confirm_message].presence || I18n.t("iron_admin.resources.action.confirm")
        .flex.items-center.gap-3.pt-5.border-t{ class: t.card_border }
          %button{ type: "submit", class: cp_btn_primary, data: @action[:confirm] ? { turbo_confirm: confirm } : {} }= I18n.t("iron_admin.resources.action_form.submit", default: "Execute")
          = link_to I18n.t("iron_admin.form.cancel_button"), resources_path(@resource_class.resource_name, **iron_admin_index_state.symbolize_keys), class: cp_btn_secondary
