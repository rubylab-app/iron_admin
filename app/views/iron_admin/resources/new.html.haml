- form_url = resources_path(@resource_class.resource_name)

.px-4.sm:px-6.lg:px-8.py-6.max-w-7xl.mx-auto
  %h1.mb-6{ class: "#{t.page_title} #{t.heading_font}" }= I18n.t("iron_admin.resources.new.title", model: @resource_class.model.model_name.human)

  .p-6{ class: cp_card }
    - if (form_component = iron_admin_form_component(@resource_class, record: @record, fields: @fields, url: form_url))
      = render form_component
    - else
      = render "form", form_url: form_url
