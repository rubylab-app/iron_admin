= form_with model: @record, url: form_url, scope: :record, html: { multipart: true } do |f|
  - if @record.errors[:base].any?
    .mb-6.px-4.py-3.text-sm{ role: "alert", class: "#{t.border_width} #{t.border_radius} #{t.alert_shadow} #{t.alert_palette[:error]}" }= @record.errors[:base].to_sentence
  .grid.grid-cols-1.md:grid-cols-2.2xl:grid-cols-3.gap-x-6.gap-y-5
    - @fields.each do |field|
      - if field.type == :hidden
        = f.hidden_field field.name
        - next
      - next unless field.visible?(iron_admin_current_user)
      - next if field.readonly?(iron_admin_current_user)
      - span_full = field.type.in?(%i[textarea json file files rich_text tags markdown code key_value boolean_group])
      - has_error = @record.errors[field.name].any?
      -# An input override gets the label for field_id(field.name). Built-in radio and boolean
      -# group choices have their own labels, so the field name labels the group instead.
      - overridden = field.type.in?(iron_admin_field_component_types)
      - group_label_id = f.field_id(field.name, :label) if !overridden && field.type.in?(%i[radio boolean_group])
      - label_target = overridden ? field.name : { belongs_to: field.options[:foreign_key], polymorphic_belongs_to: field.options[:type_column] }.fetch(field.type, field.name)
      %div{ class: span_full ? "md:col-span-2 2xl:col-span-3" : nil }
        - if group_label_id
          %span{ id: group_label_id, class: "block text-sm font-medium #{cp_label_text} #{t.field_label_transform} mb-1.5" }= field.name.to_s.humanize
        - else
          -# trix-editor is not labelable: the rich text editor takes its name from the label's id.
          = f.label label_target, field.name.to_s.humanize, id: (f.field_id(field.name, :label) if field.type == :rich_text),
            class: "block text-sm font-medium #{cp_label_text} #{t.field_label_transform} mb-1.5"
        - case field.type
        - when *iron_admin_field_component_types
          = render iron_admin_field_component(f, field)
        - when :belongs_to
          - assoc_class = field.options[:association_class]
          - fk = field.options[:foreign_key]
          - display_method = field.options[:display]
          - association_resource = association_resource_for(field, assoc_class)
          - if field.options[:autocomplete]
            - selected_record = @record.public_send(field.name) if @record.respond_to?(field.name)
            - autocomplete_resource_name = association_resource&.resource_name || assoc_class.model_name.route_key
            - autocomplete_component = IronAdmin::Form::BelongsToAutocompleteComponent.new(name: "record[#{fk}]", input_id: f.field_id(fk), resource_name: autocomplete_resource_name, selected_id: @record.public_send(fk), selected_label: selected_record ? display_record_label(selected_record, display_method) : nil, has_error: has_error)
            = render autocomplete_component
          - else
            - belongs_to_scope = assoc_class.all
            - tenant_scope = IronAdmin.configuration.tenant_scope_block
            - belongs_to_scope = tenant_scope.call(belongs_to_scope) if tenant_scope
            - belongs_to_options = belongs_to_scope.map { |r| [display_record_label(r, display_method), r.id] }
            = f.select fk,
              options_for_select(belongs_to_options, @record.public_send(fk)),
              { include_blank: I18n.t("iron_admin.fields.select_placeholder") },
              class: cp_select_class(error: has_error)
        - when :text
          = f.text_field field.name, placeholder: field.name.to_s.humanize, class: cp_input_class(error: has_error)
        - when :textarea
          = f.text_area field.name, rows: 4, placeholder: field.name.to_s.humanize, class: cp_textarea_class(error: has_error)
        - when :number
          = f.number_field field.name, placeholder: I18n.t("iron_admin.fields.number_placeholder"),
            class: cp_input_class(error: has_error)
        - when :boolean
          .flex.items-center.pt-1{ class: "gap-2.5" }
            = f.check_box field.name, class: cp_checkbox_class
            %span.text-sm{ class: cp_body_text }= I18n.t("iron_admin.fields.boolean_enable", field: field.name.to_s.humanize.downcase)
        - when :datetime, :date
          = f.datetime_local_field field.name, class: cp_input_class(error: has_error)
        - when :badge
          - badge_choices = field.options[:colors]&.keys&.map(&:to_s)
          - badge_choices ||= @record.class.defined_enums[field.name.to_s]&.keys if @record.class.respond_to?(:defined_enums)
          - badge_choices ||= []
          = f.select field.name, badge_choices.map { |c| [c.humanize, c] },
            { include_blank: I18n.t("iron_admin.fields.select_placeholder") },
            class: cp_select_class(error: has_error)
        - when :select
          = f.select field.name, field.options[:choices]&.map { |c| [c.humanize, c] },
            { include_blank: I18n.t("iron_admin.fields.select_placeholder") },
            class: cp_select_class(error: has_error)
        - when :password
          = f.password_field field.name, placeholder: field.name.to_s.humanize, autocomplete: "new-password",
            class: cp_input_class(error: has_error)
        - when :url
          = f.url_field field.name, placeholder: I18n.t("iron_admin.fields.url_placeholder"),
            class: cp_input_class(error: has_error)
        - when :email
          = f.email_field field.name, placeholder: I18n.t("iron_admin.fields.email_placeholder"),
            class: cp_input_class(error: has_error)
        - when :color
          -# Only the hex input has a name, so the form submits one value; cp-color-field keeps the picker in sync.
          .flex.items-center.gap-3{ data: { controller: "cp-color-field" } }
            = f.color_field field.name, name: nil, id: "#{f.field_id(field.name)}_picker",
              "aria-label": I18n.t("iron_admin.fields.color_picker_label", field: field.name.to_s.humanize),
              class: "h-9 w-14 shrink-0 cursor-pointer p-0.5 #{t.control_radius} #{t.border_width} #{t.input_border} #{t.card_bg}",
              data: { cp_color_field_target: "picker", action: "input->cp-color-field#fromPicker" }
            = f.text_field field.name, placeholder: I18n.t("iron_admin.fields.color_placeholder"),
              pattern: "#(?:[0-9a-fA-F]{3}){1,2}", title: I18n.t("iron_admin.fields.color_invalid"),
              class: "#{cp_input_class(error: has_error)} flex-1 #{t.code_font}",
              data: { cp_color_field_target: "text", action: "input->cp-color-field#fromText" }
        - when :currency
          .relative
            %span.pointer-events-none.absolute.inset-y-0.left-0.flex.items-center.pl-3.text-sm{ class: cp_muted_text }
              = field.options[:symbol] || "$"
            = f.number_field field.name, step: "0.01", placeholder: I18n.t("iron_admin.fields.currency_placeholder"),
              class: cp_input_class(error: has_error, padding: "pl-7 pr-3")
        - when :file
          - attachment = @record.public_send(field.name) if @record.respond_to?(field.name)
          - if attachment&.attached?
            .flex.items-center.gap-3.mb-2.p-3{ class: "#{t.border_width} #{t.border_radius} #{t.card_border} #{t.surface_muted}" }
              - if attachment.image?
                = image_tag main_app.url_for(attachment), class: "h-16 w-16 object-cover #{t.control_radius}"
              - else
                .flex.items-center.gap-2
                  = heroicon "paper-clip", variant: :mini, options: { class: "h-5 w-5 #{cp_muted_text}" }
                  %span.text-sm{ class: cp_body_text }= attachment.filename
              .ml-auto
                = f.label "#{field.name}_purge", class: "flex items-center gap-1.5 text-sm cursor-pointer #{t.error_text}" do
                  = check_box_tag "record[#{field.name}_purge]", "1", false, id: f.field_id("#{field.name}_purge"), class: cp_checkbox_class
                  = I18n.t("iron_admin.fields.file_remove")
          = f.file_field field.name, class: cp_file_input_class(error: has_error)
        - when :files
          - attachments = @record.public_send(field.name) if @record.respond_to?(field.name)
          - if attachments&.attached?
            .flex.flex-wrap.gap-3.mb-2
              - attachments.each do |attachment|
                .flex.items-center.gap-2.p-2{ class: "#{t.border_width} #{t.border_radius} #{t.card_border} #{t.surface_muted}" }
                  - if attachment.image?
                    = image_tag main_app.url_for(attachment), class: "h-12 w-12 object-cover #{t.control_radius}"
                  - else
                    .flex.items-center{ class: "gap-1.5" }
                      = heroicon "paper-clip", variant: :mini, options: { class: "h-4 w-4 #{cp_muted_text}" }
                      %span.text-xs{ class: cp_body_text }= attachment.filename
          = f.file_field field.name, multiple: true, class: cp_file_input_class(error: has_error)
        - when :markdown
          = f.text_area field.name, rows: 8, placeholder: I18n.t("iron_admin.fields.markdown_placeholder"),
            class: "#{cp_textarea_class(error: has_error)} #{t.code_font}"
        - when :rich_text
          -# Trix inserts its toolbar before the editor, inside this box (rich_text_toolbar). Its
          -# cp-rich-text-field mark makes engine.css wrap the toolbar's buttons on narrow screens, and the
          -# editor's cp-rich-text mark makes it hand Trix's border and radius to rich_text_editor.
          %div{ class: "cp-rich-text-field #{t.rich_text_toolbar}" }
            = f.rich_text_area field.name, "aria-labelledby": f.field_id(field.name, :label),
              class: t.rich_text_editor.present? ? "trix-content text-sm cp-rich-text #{t.rich_text_editor}" : "trix-content text-sm"
        - when :polymorphic_belongs_to
          - types = field.options[:types] || []
          - type_col = field.options[:type_column]
          - id_col = field.options[:id_column]
          - current_type = @record.public_send(type_col)
          - current_id = @record.public_send(id_col)
          .space-y-2
            = f.select type_col,
              types.map { |klass| [klass.model_name.human, klass.name] },
              { include_blank: I18n.t("iron_admin.fields.select_placeholder"), selected: current_type },
              class: cp_select_class(error: has_error)
            = f.select id_col,
              (current_type.present? ? current_type.constantize.all.map { |r| [display_record_label(r), r.id] } : []),
              { include_blank: I18n.t("iron_admin.fields.select_placeholder"), selected: current_id },
              "aria-label": I18n.t("iron_admin.fields.polymorphic_record_label", field: field.name.to_s.humanize),
              class: cp_select_class(error: has_error)
        - when :tags
          - current_tags = @record.public_send(field.name)
          - tag_values = current_tags.is_a?(Array) ? current_tags : current_tags.to_s.split(",").map(&:strip).reject(&:blank?)
          - container_id = "tags-container-#{field.name}"
          - tag_chip_class = "inline-flex items-center gap-1 pl-2 pr-1 text-xs py-0.5 #{t.badge_shape} #{t.chip}"
          - tag_remove_class = "inline-flex h-4 w-4 items-center justify-center cursor-pointer #{t.control_radius} #{t.link_muted} #{t.focus_ring}"
          %div{ id: container_id, data: { tags_field: true } }
            = f.hidden_field field.name, value: tag_values.join(","), id: "tags-hidden-#{field.name}"
            .flex.flex-wrap.gap-2.mb-2{ data: { tags_list: true } }
              - tag_values.each do |tag_value|
                %span{ class: tag_chip_class, data: { tag: true } }
                  = tag_value
                  %button{ type: "button", class: tag_remove_class, "aria-label": I18n.t("iron_admin.fields.tags_remove", tag: tag_value), data: { remove_tag: true } } &times;
            .flex.items-center.gap-2
              %input.flex-1{ type: "text", id: f.field_id(field.name), placeholder: I18n.t("iron_admin.fields.tags_placeholder"), data: { tag_input: true },
                class: cp_input_class(error: has_error) }
            -# The script copies this chip for each new tag, so it gets the theme's classes.
            %template{ data: { tag_template: true } }
              %span{ class: tag_chip_class, data: { tag: true } }
                %button{ type: "button", class: tag_remove_class, data: { remove_tag: true, label: I18n.t("iron_admin.fields.tags_remove", tag: "%{tag}") } } &times;
          :javascript
            (function() {
              const container = document.getElementById("#{container_id}");
              const hidden = container.querySelector("[data-tags-list] ~ .flex input[data-tag-input]").closest("[data-tags-field]").querySelector("input[type=hidden]");
              const list = container.querySelector("[data-tags-list]");
              const input = container.querySelector("[data-tag-input]");
              const template = container.querySelector("template[data-tag-template]");

              function updateHidden() {
                const tags = Array.from(list.querySelectorAll("[data-tag]")).map(el => el.textContent.replace("×", "").trim());
                hidden.value = tags.join(",");
              }

              function addTag(value) {
                const trimmed = value.trim();
                if (!trimmed) return;
                const existing = Array.from(list.querySelectorAll("[data-tag]")).map(el => el.textContent.replace("×", "").trim());
                if (existing.includes(trimmed)) return;

                const span = template.content.firstElementChild.cloneNode(true);
                const btn = span.querySelector("[data-remove-tag]");
                span.insertBefore(document.createTextNode(trimmed), btn);
                btn.setAttribute("aria-label", btn.dataset.label.replace("%{tag}", trimmed));
                btn.removeAttribute("data-label");
                btn.addEventListener("click", function() { span.remove(); updateHidden(); });
                list.appendChild(span);
                updateHidden();
              }

              input.addEventListener("keydown", function(e) {
                if (e.key === "Enter" || e.key === ",") {
                  e.preventDefault();
                  addTag(input.value);
                  input.value = "";
                }
              });

              input.addEventListener("blur", function() {
                if (input.value.trim()) { addTag(input.value); input.value = ""; }
              });

              list.querySelectorAll("[data-remove-tag]").forEach(function(btn) {
                btn.addEventListener("click", function() { btn.closest("[data-tag]").remove(); updateHidden(); });
              });
            })();
        - when :key_value
          = f.text_area field.name, rows: field.options[:rows] || 6,
            placeholder: '{"key": "value"}',
            class: "#{cp_textarea_class(error: has_error)} #{t.code_font}"
        - when :json
          - raw_json_value = @record.public_send(field.name)
          - submitted_json = @invalid_json_values&.[](field.name)
          - json_str = submitted_json || (raw_json_value.nil? ? "" : JSON.pretty_generate(raw_json_value))
          = text_area_tag "record[#{field.name}]", json_str,
            id: "record_#{field.name}", rows: field.options[:rows] || 8, placeholder: "{}",
            class: "#{cp_textarea_class(error: has_error)} #{t.code_font}"
        - when :boolean_group
          - choices = field.options[:choices] || []
          - current_values = @record.public_send(field.name).to_s.split(",").map(&:strip)
          - container_id = "boolean-group-#{field.name}"
          %div{ id: container_id, data: { boolean_group_field: true } }
            = f.hidden_field field.name, value: current_values.join(","), id: "boolean-group-hidden-#{field.name}"
            .flex.flex-wrap.gap-3{ role: "group", "aria-labelledby": group_label_id }
              - choices.each do |choice|
                - label_text, choice_value = choice.is_a?(Array) ? choice : [choice.to_s.humanize, choice]
                %label.inline-flex.items-center.gap-2.cursor-pointer
                  %input{ type: "checkbox", value: choice_value,
                          checked: current_values.include?(choice_value.to_s),
                          class: cp_checkbox_class,
                          data: { boolean_group_checkbox: true } }
                  %span.text-sm= label_text
            :javascript
              (function() {
                var container = document.getElementById("#{container_id}");
                var hidden = document.getElementById("boolean-group-hidden-#{field.name}");
                var checkboxes = container.querySelectorAll("[data-boolean-group-checkbox]");
                function update() {
                  var vals = [];
                  checkboxes.forEach(function(cb) { if (cb.checked) vals.push(cb.value); });
                  hidden.value = vals.join(",");
                }
                checkboxes.forEach(function(cb) { cb.addEventListener("change", update); });
              })();
        - when :external_image
          = f.url_field field.name, placeholder: I18n.t("iron_admin.fields.url_placeholder"),
            class: cp_input_class(error: has_error)
        - when :progress_bar
          = f.number_field field.name, min: field.options[:min] || 0, max: field.options[:max] || 100,
            placeholder: "0", class: cp_input_class(error: has_error)
        - when :code
          = f.text_area field.name, rows: field.options[:rows] || 10, class: "#{cp_textarea_class(error: has_error)} #{t.code_font}"
        - when :radio
          - layout = field.options[:layout] == :vertical ? "flex-col space-y-2" : "flex flex-wrap gap-4"
          - choices = field.options[:choices] || []
          .flex{ class: layout, role: "radiogroup", "aria-labelledby": group_label_id }
            - choices.each do |choice|
              - label_text, choice_value = choice.is_a?(Array) ? choice : [choice.to_s.humanize, choice]
              %label.inline-flex.items-center.gap-2.cursor-pointer
                %input{ type: "radio", name: "record[#{field.name}]",
                        value: choice_value,
                        checked: @record.public_send(field.name).to_s == choice_value.to_s,
                        class: cp_radio_class }
                %span.text-sm= label_text
        - else
          - custom_config = IronAdmin::FieldTypeRegistry.find(field.type) if IronAdmin::FieldTypeRegistry.registered?(field.type)
          - if custom_config&.form_component_class
            = render custom_config.form_component_class.new(form: f, field: field, record: @record)
          - elsif custom_config&.form_partial_path
            = render partial: custom_config.form_partial_path, locals: { f: f, field: field, record: @record }
          - else
            = f.text_field field.name, placeholder: field.name.to_s.humanize, class: cp_input_class(error: has_error)

        - if has_error
          .flex.items-center{ class: "gap-1.5 mt-1.5" }
            = heroicon "exclamation-circle", variant: :mini, options: { class: "h-4 w-4 shrink-0 #{t.error_text}" }
            %p.text-sm{ class: t.error_text }= @record.errors[field.name].join(", ")

  - @resource_class.habtm_associations.each do |assoc|
    - ids_attribute = "#{assoc[:name].to_s.singularize}_ids"
    .md:col-span-2.2xl:col-span-3.mt-4
      %span.block.text-sm.font-medium.mb-2{ id: f.field_id(ids_attribute, :label), class: "#{cp_label_text} #{t.field_label_transform}" }= assoc[:name].to_s.humanize
      - all_options = assoc[:reflection].klass.all
      - selected_ids = @record.public_send(assoc[:name]).pluck(:id)
      .flex.flex-wrap.gap-3{ role: "group", "aria-labelledby": f.field_id(ids_attribute, :label) }
        - all_options.each do |option|
          %label.inline-flex.items-center.gap-2.cursor-pointer
            = check_box_tag "record[#{ids_attribute}][]", option.id, selected_ids.include?(option.id), id: f.field_id(ids_attribute, option.id), class: cp_checkbox_class
            %span.text-sm{ class: cp_body_text }= display_record_label(option, assoc[:display])

  - @resource_class.nested_associations.each do |nested_assoc|
    .mt-6
      = render IronAdmin::Form::NestedFormComponent.new(form: f, nested_association: nested_assoc, record: @record, current_user: iron_admin_current_user)

  .flex.items-center.gap-3.mt-8.pt-6.border-t{ class: t.card_border }
    = f.submit class: cp_btn_primary_lg
    = link_to I18n.t("iron_admin.form.cancel_button"), resources_path(@resource_class.resource_name),
      class: cp_btn_secondary
