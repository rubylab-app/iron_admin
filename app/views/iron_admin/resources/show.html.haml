- styles = IronAdmin::Resources::Styles

.px-4.sm:px-6.lg:px-8.py-6.max-w-7xl.mx-auto
  .flex.items-center.justify-between.gap-3.flex-wrap.mb-6
    %h1{ class: styles.page_title(t) }
      = @resource_class.model.model_name.human
      %span{ class: cp_muted_text }= "##{@record.id}"
    .flex.gap-2.flex-wrap
      - if @resource_class.crud_allowed?(:update, iron_admin_current_user) && @record_reachable
        = link_to I18n.t("iron_admin.resources.show.edit_button"), edit_resource_path(@resource_class.resource_name, @record),
          class: cp_btn_primary
      - if @resource_class.crud_allowed?(:destroy, iron_admin_current_user)
        = button_to I18n.t("iron_admin.resources.show.delete_button"), resource_path(@resource_class.resource_name, @record),
          method: :delete, data: { turbo_confirm: I18n.t("iron_admin.resources.show.delete_confirm") },
          class: cp_btn_danger

  .overflow-hidden{ class: styles.panel(t) }
    %dl{ class: styles.divided(t) }
      - @fields.each do |field|
        - next unless field.visible?(iron_admin_current_user)
        %div{ class: styles::DETAIL_ROW }
          %dt.text-sm.font-medium{ class: "sm:w-1/3 #{t.muted_text}" }= field.name.to_s.humanize
          %dd.text-sm.break-words{ class: "sm:w-2/3 #{t.body_text}" }= display_field_value(@record, field)

  - @resource_class.has_one_associations.each do |assoc|
    - related_record = @record.public_send(assoc[:name])
    - next unless related_record
    .mt-6.overflow-hidden{ class: styles.panel(t) }
      %div{ class: styles.panel_header(t) }
        %h2{ class: styles.panel_title(t) }= assoc[:name].to_s.humanize
        = link_to I18n.t("iron_admin.resources.show.view_link"),
          resource_path(assoc[:resource].resource_name, related_record),
          class: "text-sm #{cp_link}"
      %dl{ class: styles.divided(t) }
        - assoc[:resource].resolved_fields.first(6).each do |field|
          - next if field.name == :id
          - next unless field.visible?(iron_admin_current_user)
          %div{ class: styles::DETAIL_ROW }
            %dt.text-sm.font-medium{ class: "sm:w-1/3 #{t.muted_text}" }= field.name.to_s.humanize
            %dd.text-sm.break-words{ class: "sm:w-2/3 #{t.body_text}" }= display_field_value(related_record, field)

  - @resource_class.habtm_associations.each do |assoc|
    - related_records = @record.public_send(assoc[:name])
    - next if related_records.empty?
    .mt-6{ class: styles.panel(t) }
      %div{ class: styles.panel_header(t) }
        %h2{ class: styles.panel_title(t) }= assoc[:name].to_s.humanize
      .flex.flex-wrap.gap-2.px-4.py-3
        - related_records.each do |related|
          - display = assoc[:display]
          - if assoc[:resource]
            = link_to display_record_label(related, display),
              resource_path(assoc[:resource].resource_name, related),
              class: "inline-flex items-center px-2 py-0.5 text-xs transition-opacity hover:opacity-75 #{t.badge_shape} #{t.chip} #{t.focus_ring}"
          - else
            %span{ class: "inline-flex items-center px-2 py-0.5 text-xs #{t.badge_shape} #{t.chip}" }
              = display_record_label(related, display)

  - @resource_class.has_many_associations.each do |assoc|
    = render IronAdmin::Resources::RelatedListComponent.new(association: assoc,
      records: @record.public_send(assoc[:name]), parent: @record)

  - if @member_actions.any?
    .mt-6.p-4{ class: styles.panel(t) }
      %h2.mb-3{ class: styles.panel_title(t) }= I18n.t("iron_admin.resources.show.actions_label")
      .flex.gap-2.flex-wrap
        - @member_actions.each do |action|
          - confirm = action[:confirm_message].presence || I18n.t("iron_admin.resources.action.confirm")
          = button_to resource_action_path(@resource_class.resource_name, @record, action[:name]),
            data: action[:confirm] ? { turbo_confirm: confirm } : {},
            class: styles.secondary_button(t) do
            - if action[:icon]
              = heroicon action[:icon], variant: :outline, options: { class: "h-4 w-4" }
            = action[:name].to_s.humanize
