.px-4.sm:px-6.lg:px-8.py-6.max-w-7xl.mx-auto
  %h1.mb-6{ class: "#{t.page_title} #{t.heading_font}" }= IronAdmin.configuration.title

  - if @dashboard
    - if @dashboard.defined_metrics.any?
      .grid.grid-cols-1.md:grid-cols-2.xl:grid-cols-4.gap-4.mb-6
        - @dashboard.defined_metrics.each do |metric|
          = render IronAdmin::Dashboards::MetricCardComponent.new(name: metric[:name], value: metric[:block].call, format: metric[:format], icon: metric[:icon], live: metric[:live])

    - if @dashboard.defined_charts.any?
      = javascript_include_tag "chart.min", defer: true, onload: "document.dispatchEvent(new CustomEvent('chartjs:loaded'))"
      .grid.grid-cols-1.lg:grid-cols-2.gap-4.mb-6
        - @dashboard.defined_charts.each do |chart|
          - chart_data = chart[:block].call
          - labels = chart_data.keys
          - data = chart_data.values
          - chart_title = chart[:label] || chart[:name].to_s.humanize
          - if chart[:live]
            %div{ id: "chart_#{chart[:name].to_s.parameterize(separator: "_")}" }
              = render IronAdmin::Dashboards::ChartComponent.new(title: chart_title, type: chart[:type], data: data, labels: labels, colors: chart[:colors])
          - else
            = render IronAdmin::Dashboards::ChartComponent.new(title: chart_title, type: chart[:type], data: data, labels: labels, colors: chart[:colors])

    - if @dashboard.defined_progress_bars.any?
      .grid.grid-cols-1.md:grid-cols-2.lg:grid-cols-3.gap-4.mb-6
        - @dashboard.defined_progress_bars.each do |bar|
          - bar_title = bar[:label] || bar[:name].to_s.humanize
          = render IronAdmin::Dashboards::ProgressComponent.new(title: bar_title, value: bar[:block].call, max: bar[:max], format: bar[:format], color: bar[:color])

    - if @dashboard.defined_recents.any?
      .space-y-4
        - @dashboard.defined_recents.each do |recent|
          - resource_class = IronAdmin::ResourceRegistry.find(recent[:resource_name].to_s.pluralize)
          -# Like the index page: the read policy decides, and tenant_scope applies after the recent scope.
          - if resource_class&.crud_allowed?(:read, iron_admin_current_user)
            - scope = recent[:scope] ? resource_class.model.instance_exec(&recent[:scope]) : resource_class.model.all
            - scope = IronAdmin.configuration.tenant_scope_block.call(scope) if IronAdmin.configuration.tenant_scope_block
            - records = scope.limit(recent[:limit])
            = render IronAdmin::Dashboards::RecentTableComponent.new(resource_name: recent[:resource_name], records: records, current_user: iron_admin_current_user)

  - else
    .p-12.text-center{ class: "#{t.card_bg} #{t.border_width} #{t.card_border} #{t.border_radius} #{t.card_shadow}" }
      %p.text-sm{ class: t.muted_text } No dashboard configured. Create an AdminDashboard in app/iron_admin/.
