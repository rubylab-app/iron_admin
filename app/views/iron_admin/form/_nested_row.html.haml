- t = IronAdmin.current_theme
- controls = IronAdmin::Form::ControlClasses

%div.relative.p-4.mb-3{ class: "#{t.border_width} #{t.border_radius} #{t.card_border} #{t.surface_muted}", data: { "cp-nested-form-target": "row" } }

  -# Drag handle (only when sortable)
  - if nested_association.position_field
    .absolute.top-2.left-2.cursor-grab{ class: t.icon_muted, data: { "cp-nested-form-target": "dragHandle" } }
      = heroicon "bars-3", variant: :mini, options: { class: "h-5 w-5" }
    = child_f.hidden_field nested_association.position_field, data: { "cp-nested-form-target": "positionField" }

  -# Remove button (only when allow_destroy)
  - if nested_association.allow_destroy
    .absolute.top-2.right-2
      %button.transition.cursor-pointer{ type: "button", class: "#{t.control_radius} #{t.link_muted} #{t.focus_ring}", aria: { label: I18n.t("iron_admin.nested_form.remove_button", default: "Remove") }, data: { action: "cp-nested-form#removeRow" } }
        = heroicon "x-mark", variant: :mini, options: { class: "h-5 w-5" }
    = child_f.hidden_field :_destroy, value: "0", data: { "cp-nested-form-target": "destroyField" }

  -# Hidden id field for persisted records
  - if child.persisted?
    = child_f.hidden_field :id

  -# Field grid
  %div{ class: "grid grid-cols-1 md:grid-cols-2 gap-x-4 gap-y-3 #{nested_association.position_field ? 'pl-6' : ''}" }
    - nested_association.fields.each do |field|
      - next unless field.visible?(current_user)
      - next if field.readonly?(current_user)
      - has_error = child.errors[field.name].any?
      - input_class = controls.input(t, error: has_error)
      - select_class = controls.select(t, error: has_error)
      - textarea_class = controls.textarea(t, error: has_error)
      %div
        = child_f.label(field.type == :belongs_to ? field.options[:foreign_key] : field.name, field.name.to_s.humanize,
          class: "block text-xs font-medium mb-1 #{t.label_text} #{t.field_label_transform}")
        - case field.type
        - when :belongs_to
          - fk = field.options[:foreign_key]
          - assoc_class = field.options[:association_class]
          - if assoc_class
            = child_f.select fk, options_from_collection_for_select(assoc_class.all, :id, :name, child.public_send(fk)), { include_blank: true }, class: select_class
          - else
            = child_f.number_field fk, placeholder: field.name.to_s.humanize, class: input_class
        - when :textarea
          = child_f.text_area field.name, rows: 2, class: textarea_class
        - when :json
          - raw_json_value = child.public_send(field.name)
          - json_str = raw_json_value.nil? ? "" : JSON.pretty_generate(raw_json_value)
          = child_f.text_area field.name, value: json_str, rows: field.options[:rows] || 4,
            placeholder: "{}", class: "#{textarea_class} #{t.code_font}"
        - when :number
          = child_f.number_field field.name, class: input_class
        - when :boolean
          .flex.items-center.gap-2
            = child_f.check_box field.name, class: controls.checkbox(t)
        - when :datetime, :date
          = child_f.datetime_local_field field.name, class: input_class
        - when :select, :badge
          - choices = []
          - if field.type == :badge
            - colors = field.options[:colors]
            - if colors
              - choices = colors.keys.map { |c| [c.to_s.humanize, c] }
            - elsif child.class.respond_to?(:defined_enums)
              - choices = child.class.defined_enums[field.name.to_s]&.keys&.map { |c| [c.humanize, c] } || []
          - elsif field.options[:choices]
            - choices = field.options[:choices].map { |c| [c.humanize, c] }
          = child_f.select field.name, choices, { include_blank: true }, class: select_class
        - else
          = child_f.text_field field.name, placeholder: field.name.to_s.humanize, class: input_class

        - if has_error
          %p.text-xs.mt-1{ class: t.error_text }= child.errors[field.name].join(", ")
