-# One field of an action form (resource, bulk and tool actions); scope is the params key.
-# value is the submitted value (the field's default when the form first shows), and errors
-# are the messages shown under the field, as resource forms show theirs.
- input_id = "#{scope}_#{field.name}"
- input_name = "#{scope}[#{field.name}]"
- value = local_assigns.fetch(:value, field.default)
- errors = Array(local_assigns[:errors])
- has_error = errors.any?
- error_id = "#{input_id}_error"
- invalid = has_error ? { invalid: true, describedby: error_id } : {}
%div{ class: "space-y-1.5" }
  %label.block.text-sm.font-medium{ class: "#{cp_label_text} #{t.field_label_transform}", for: input_id }
    = field.label
    - if field.required
      %span{ class: t.error_text } *

  - case field.type
  - when :text
    = text_field_tag input_name, value, id: input_id, class: cp_input_class(error: has_error),
      placeholder: field.placeholder, required: field.required, aria: invalid
  - when :textarea
    = text_area_tag input_name, value, id: input_id, rows: 4, class: cp_textarea_class(error: has_error),
      placeholder: field.placeholder, required: field.required, aria: invalid
  - when :number
    = number_field_tag input_name, value, id: input_id, class: cp_input_class(error: has_error),
      placeholder: field.placeholder, step: "any", required: field.required, aria: invalid
  - when :boolean
    .flex.items-center.gap-2
      = check_box_tag input_name, "1", ActiveModel::Type::Boolean.new.cast(value), id: input_id, class: cp_checkbox_class,
        required: field.required, aria: invalid
      %span.text-sm{ class: cp_body_text }= field.label
  - when :date
    = date_field_tag input_name, value, id: input_id, class: cp_input_class(error: has_error), required: field.required, aria: invalid
  - when :datetime
    = datetime_field_tag input_name, value, id: input_id, class: cp_input_class(error: has_error), required: field.required, aria: invalid
  - when :select
    %select{ name: input_name, id: input_id, class: cp_select_class(error: has_error), required: field.required, aria: invalid }
      %option{ value: "" }= field.placeholder || "Select..."
      - (field.options || []).each do |opt|
        %option{ value: opt, selected: value.to_s == opt.to_s }= opt.to_s.humanize

  - if has_error
    .flex.items-center{ class: "gap-1.5" }
      = heroicon "exclamation-circle", variant: :mini, options: { class: "h-4 w-4 shrink-0 #{t.error_text}" }
      %p.text-sm{ id: error_id, class: t.error_text }= errors.join(", ")
