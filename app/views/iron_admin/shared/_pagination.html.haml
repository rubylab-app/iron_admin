-# locals: (pagy:)
- if pagy.pages > 1
  - link_classes = "relative inline-flex h-8 items-center px-3 text-sm font-medium transition-colors duration-150 #{t.control_radius} #{t.btn_secondary} #{t.focus_ring}"
  -# A link with no href, marked disabled: its faded text is exempt from WCAG contrast.
  - disabled_classes = "relative inline-flex h-8 items-center px-3 text-sm font-medium cursor-not-allowed #{t.control_radius} #{t.border_width} #{t.card_border} #{t.card_bg} #{t.disabled_text}"
  %nav.flex.items-center.justify-between.gap-3.py-1{ "aria-label": "Pagination" }
    .hidden{ class: "sm:block" }
      %p.text-sm{ class: t.muted_text }
        Showing
        %span.font-medium.tabular-nums{ class: t.body_text }= pagy.from
        to
        %span.font-medium.tabular-nums{ class: t.body_text }= pagy.to
        of
        %span.font-medium.tabular-nums{ class: t.body_text }= pagy.count
        results

    .flex.flex-1.justify-between.gap-2{ class: "sm:justify-end" }
      - if pagy.previous
        = link_to url_for(request.query_parameters.merge(page: pagy.previous)), class: link_classes do
          Previous
      - else
        %span{ class: disabled_classes, role: "link", "aria-disabled": "true" }
          Previous

      - if pagy.next
        = link_to url_for(request.query_parameters.merge(page: pagy.next)), class: link_classes do
          Next
      - else
        %span{ class: disabled_classes, role: "link", "aria-disabled": "true" }
          Next
