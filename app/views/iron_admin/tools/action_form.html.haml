.px-4.sm:px-6.lg:px-8.py-6.max-w-lg.mx-auto
  %h1.mb-6{ class: "#{t.page_title} #{t.heading_font}" }= @declared_action.label

  .p-6{ class: cp_card }
    = form_tag @form_url, method: :post, class: "space-y-5" do
      - @form_fields.each do |field|
        = render "iron_admin/form/action_field", field: field, scope: "tool_action"

      .flex.items-center.gap-3.pt-5.border-t{ class: t.card_border }
        %button{ type: "submit", class: cp_btn_primary }= I18n.t("iron_admin.tools.action_form.submit", default: "Execute")
        = link_to I18n.t("iron_admin.form.cancel_button"), tool_path(@tool_class.tool_name), class: cp_btn_secondary
