IronAdmin.configure do |config|
  config.title = "<%= Rails.application.class.module_parent_name %> Admin"

  # Every request is denied (403) until you replace this block with your
  # app's authentication: return false to deny, redirect to your sign-in
  # page, or return anything else to allow. Recipes for Devise and the
  # Rails 8 authentication generator:
  # https://github.com/rubylab-app/iron_admin/blob/main/docs/guides/authentication.md
  config.authenticate do |_controller|
    false
  end

  config.current_user do |controller|
    # User.find_by(id: controller.session[:user_id])
  end
end
